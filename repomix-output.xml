                'is_required' => $field['is_required'] ?? $field['required'],
                'options' => $field['options'] ?? null,
            ]);
        }
    }

    private function addIcon($model, $url)
    {
        try {
            $model->addMediaFromUrl($url)->toMediaCollection('icons');
        } catch (\Exception $e) {
        }
    }
}
