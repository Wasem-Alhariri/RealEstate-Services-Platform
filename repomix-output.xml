  /* Tab link */
  .nav-link {
    @include border-radius(0);
    background-clip: padding-box;
  }
  .nav-link.active,
  .nav-item.show .nav-link {
    &,
    &:hover,
    &:focus {
      box-shadow: 0 -2px 0 $nav-tabs-link-active-border-color inset;
      .nav-align-top & {
