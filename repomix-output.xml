            $parent = Category::create([
                'name' => $item['name'],
                'isActive' => true,
                'parent_id' => null
            ]);

            $this->addIcon($parent, $item['icon']);
            $this->createFields($parent, $item['fields']);

            foreach ($item['children'] as $childData) {
                $child = Category::create([
                    'name' => $childData['name'],
                    'isActive' => true,
                    'parent_id' => $parent->id
                ]);
